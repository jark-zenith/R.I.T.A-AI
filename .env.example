# Public runtime configuration (safe to expose through Next.js public variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: canonical public origin used for OAuth and password recovery redirects.
# Must also be allowlisted in Supabase Authentication -> URL Configuration.
NEXT_PUBLIC_SITE_URL=https://your-rita-domain.example
